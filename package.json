{
  "name": "slidev-check",
  "version": "0.0.0-semantically-released",
  "description": "Audit rendered Slidev slides for layout problems such as overflowing elements.",
  "keywords": [
    "slidev",
    "slides",
    "presentation",
    "linter",
    "layout",
    "overflow",
    "playwright"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/slidev-check.git"
  },
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "slidev-check": "./src/cli.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check": "bun wb verify",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "release": "wb release",
    "start": "bun src/cli.ts",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "dependencies": {
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@slidev/cli": "52.19.1",
    "@slidev/theme-default": "latest",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.2",
    "@willbooster/oxfmt-config": "1.2.2",
    "@willbooster/oxlint-config": "1.4.8",
    "@willbooster/wb": "22.7.1",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright-chromium": "1.63.0",
    "semantic-release": "25.0.9",
    "sort-package-json": "4.0.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@slidev/cli": "^52.0.0",
    "playwright-chromium": "^1.10.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
